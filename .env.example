# Ертегі диктант — орта (environment) айнымалылары
# Порт (локалды) / Render портты өзі береді
PORT=4000

# JWT құпия кілті — міндетті түрде өзгертіңіз (Render: generateValue)
JWT_SECRET=change-me-to-a-long-random-string

# SQLite дерекқор папкасы (Render: /opt/render/project/src/data)
DATA_DIR=./server/data

# Платформада қосылуы мүмкін домен (CORS үшін, келіспесі мүмкін)
PUBLIC_URL=https://your-app.onrender.com
